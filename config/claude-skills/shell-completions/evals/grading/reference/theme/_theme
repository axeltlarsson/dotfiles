#compdef theme
# zsh completion for theme — grammar read from the dispatcher in config/scripts/theme.sh;
# verified by theme.cases.tsv.

_theme() {
  local curcontext="$curcontext" context state state_descr line ret=1
  typeset -A opt_args

  _arguments -C '1: :->cmd' '*:: :->args' && ret=0

  case $state in
    cmd)
      # bare `theme` prints the current appearance; `theme help` is a usage error, so no help word
      local -a commands=(
        'light:pin the macOS appearance to light, then sync'
        'dark:pin the macOS appearance to dark, then sync'
        'toggle:flip the macOS appearance, then sync'
        'auto:hand the appearance back to the macOS schedule'
        'sync:re-apply the current appearance without changing it'
      )
      _describe -t commands 'theme command' commands && ret=0
      ;;
    args)
      curcontext="${curcontext%:*:*}:theme-$words[1]:"
      case $words[1] in
        sync)
          # theme.sh: apply "${2:-}" — only the literal --force does anything, only as $2
          _arguments '1::option:((--force\:"also push to running neovim when nothing changed"))' && ret=0
          ;;
        light | dark | toggle | auto)
          _message 'no more arguments' # extra words are silently ignored by the script
          ;;
        *)
          _message "unknown command: $words[1]"
          ;;
      esac
      ;;
  esac
  return ret
}

if [[ $funcstack[1] == _theme ]]; then
  _theme "$@"
else
  (( $+functions[compdef] )) && compdef _theme theme
fi
# vim: ft=zsh
